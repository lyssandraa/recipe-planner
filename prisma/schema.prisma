// Prisma schema for the recipe planner.
// Single-user app, SQLite file database, no auth.

// The client is constructed with a libSQL driver adapter (lib/prisma.ts),
// so the exact same schema and generated client work against a local
// SQLite file in development and a remote Turso database in production,
// no provider switch needed. Driver adapters are stable as of this Prisma
// version, no previewFeatures flag required.
generator client {
  provider = "prisma-client-js"
}

// This url is a placeholder only, never actually connected to: both the app
// (lib/prisma.ts) and the CLI (prisma.config.ts) construct a PrismaLibSql
// driver adapter directly from DATABASE_URL/TURSO_AUTH_TOKEN, which is the
// real connection. The schema parser still requires this field to look like
// a valid sqlite url, hence the hardcoded file: literal.
datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
  DRINK
  BAKING
  SIDE
  SAUCE_CONDIMENT
  // Not a meal on its own: a marinade, spice mix, dressing, sauce, pickle
  // or stock meant to be used inside another recipe. See componentType on
  // Recipe and the RecipeComponent self-relation. Excluded from the recipe
  // list's normal browsing so these don't clutter dinner-picking, and
  // reachable only via an explicit filter or its own dashboard tile.
  COMPONENT
  OTHER
}

// What kind of component a COMPONENT-mealType recipe is. Only meaningful
// when mealType is COMPONENT.
enum ComponentType {
  MARINADE
  SPICE_MIX
  DRESSING
  SAUCE
  PICKLE
  STOCK
  OTHER
}

// Independent tag dimensions, each its own many-to-many via a join model
// below (RecipeCuisine etc.) since SQLite has no native enum-array column.
// A recipe can carry zero, one, or several values per dimension.
enum Cuisine {
  BRITISH
  ITALIAN
  FRENCH
  GREEK
  MIDDLE_EASTERN
  NORTH_AFRICAN
  INDIAN
  CHINESE
  THAI
  JAPANESE
  MEXICAN
  SPANISH
  AMERICAN
  OTHER
}

enum Mood {
  COMFORTING
  FRESH_LIGHT
  HEARTY
  SPICY
  WARMING
  COOLING
  INDULGENT
  QUICK_SIMPLE
}

enum Protein {
  LAMB
  CHICKEN
  BEEF
  FISH
  SEAFOOD
  EGGS
  VEGETARIAN
  VEGAN
}

enum CookMethod {
  BRAISED
  ROASTED
  GRILLED
  FRIED
  ONE_PAN
  NO_COOK
  SLOW_COOKER
  PRESSURE_COOKER
  BAKED
}

enum Season {
  SPRING
  SUMMER
  AUTUMN
  WINTER
  ALL_YEAR
}

enum StockLevel {
  PLENTY
  LOW
  OUT
}

enum IngredientCategory {
  PRODUCE
  MEAT_FISH
  DAIRY
  DRY_GOODS
  TINS_JARS
  SPICES
  BAKING
  FROZEN
  OTHER
}

enum ShoppingItemOrigin {
  RECIPE
  MANUAL
  LOW_STOCK
}

enum Unit {
  g
  kg
  ml
  l
  tsp
  tbsp
  cup
  piece
}

enum ProductSource {
  OPEN_FOOD_FACTS
  MANUAL
}

enum ClaimType {
  CERTIFIED
  REGULATED
  UNREGULATED
  // Didn't match anything in the static table (lib/claims.ts) when added,
  // so no explanation is on file yet. Distinct from UNREGULATED, which
  // means we know it's a marketing term with no legal backing, this means
  // we simply don't know what it means yet. See ProductClaim.explanation
  // for the user's own optional note.
  UNRECOGNISED
}

// Canonical ingredient. Everything else (recipes, pantry, synonyms) points here.
model Ingredient {
  id            String             @id @default(cuid())
  name          String             @unique
  plural        String?
  isStaple      Boolean            @default(false)
  category      IngredientCategory @default(OTHER)
  // User-written override. When set, takes priority over the static lookup
  // in lib/storageAdvice.ts.
  storageAdvice String?
  // Manual pantry ordering within a category group (lower first), set via
  // the up/down reorder controls. Ties (including the default) fall back
  // to alphabetical, so an unordered category still reads sensibly.
  sortOrder     Int                @default(0)

  // Descriptive-only tags for the dashboard's nutrition-ish nudges. No
  // scores, no targets, just facts to mention.
  isHighFibre  Boolean @default(false)
  isWholegrain Boolean @default(false)
  isLegume     Boolean @default(false)
  isLeafyGreen Boolean @default(false)
  isOilyFish   Boolean @default(false)

  synonyms           IngredientSynonym[]
  recipeIngredients  RecipeIngredient[]
  pantryItem         PantryItem?
  productIngredients ProductIngredient[]
  info               IngredientInfo?
  shoppingListItems  ShoppingListItem[]
  shoppingTripItems  ShoppingTripItem[]

  // "Satisfies" means having this ingredient means I don't need the other,
  // e.g. unsalted butter satisfies butter. Distinct from IngredientSynonym,
  // which means "same thing, different name". Self-relation, many-to-many:
  // `satisfies` is what this ingredient can stand in for, `satisfiedBy` is
  // what can stand in for this one.
  satisfies   Ingredient[] @relation("IngredientSatisfies")
  satisfiedBy Ingredient[] @relation("IngredientSatisfies")

  @@index([name])
}

// Alternative names that resolve to a canonical ingredient, e.g. "scallion" -> "spring onion".
// Grown manually over time as imports throw up new names.
model IngredientSynonym {
  id           String @id @default(cuid())
  name         String @unique
  ingredientId String

  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@index([ingredientId])
}

model Recipe {
  id             String   @id @default(cuid())
  title          String
  description    String?
  servings       Int?
  // Ordered list of instruction steps, stored as a JSON string:
  // { text: string, timerSeconds?: number, ingredientIds?: string[] }[]
  instructions   String
  totalTimeMins  Int?
  activeTimeMins Int?
  batchFriendly  Boolean  @default(false)
  leftoverNote   String?
  mealType       MealType @default(DINNER)
  // Only meaningful when mealType is COMPONENT: what kind of component this
  // is (marinade, spice mix, dressing, sauce, pickle, stock).
  componentType  ComponentType?
  // URL the recipe was imported from, or free text ("Mum's recipe book").
  source         String?
  // Set from the JSON-LD `image` field on import. Manual recipes leave this
  // unset and get a deterministic colour block in the UI instead.
  imageUrl       String?
  createdAt      DateTime @default(now())

  ingredients     RecipeIngredient[]
  mealPlanEntries MealPlanEntry[]
  cookLogs        CookLog[]

  cuisines RecipeCuisine[]
  moods    RecipeMood[]
  proteins RecipeProtein[]
  methods  RecipeCookMethod[]
  seasons  RecipeSeason[]

  // Other recipes this one uses as a component, e.g. a braise linking to
  // its marinade, with a note on how it's used. "components" is what this
  // recipe uses; "usedIn" is which other recipes use this one (relevant
  // when this recipe is itself a COMPONENT, e.g. showing "used in 2
  // recipes" on a marinade's own page).
  components RecipeComponent[] @relation("RecipeUsesComponents")
  usedIn     RecipeComponent[] @relation("ComponentUsedInRecipes")
}

// One tag value in the Cuisine dimension for a recipe. A plain join row
// (no own id needed, the pair is the identity) rather than a JSON array
// column, so it stays queryable ("recipes tagged Italian") the same way
// RecipeIngredient already is for ingredients.
model RecipeCuisine {
  recipeId String
  value    Cuisine

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@id([recipeId, value])
  @@index([value])
}

model RecipeMood {
  recipeId String
  value    Mood

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@id([recipeId, value])
  @@index([value])
}

model RecipeProtein {
  recipeId String
  value    Protein

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@id([recipeId, value])
  @@index([value])
}

// Named RecipeCookMethod (not RecipeMethod) to keep clear of the unrelated
// generic word "method"; the enum itself is CookMethod for the same reason.
model RecipeCookMethod {
  recipeId String
  value    CookMethod

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@id([recipeId, value])
  @@index([value])
}

model RecipeSeason {
  recipeId String
  value    Season

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@id([recipeId, value])
  @@index([value])
}

// Links a recipe to another recipe it uses as a component, e.g. a braise
// that marinates in a separately-catalogued marinade rather than
// duplicating that marinade's ingredients inline. Self-relation on Recipe,
// explicit join model (not an implicit many-to-many) since it carries a
// note.
model RecipeComponent {
  id                String  @id @default(cuid())
  parentRecipeId    String
  componentRecipeId String
  // e.g. "marinate the lamb overnight in this". Shown on the parent
  // recipe's components card.
  note              String?

  parent    Recipe @relation("RecipeUsesComponents", fields: [parentRecipeId], references: [id], onDelete: Cascade)
  component Recipe @relation("ComponentUsedInRecipes", fields: [componentRecipeId], references: [id], onDelete: Cascade)

  @@unique([parentRecipeId, componentRecipeId])
  @@index([componentRecipeId])
}

// One entry per time a recipe gets cooked. No UI beyond a single "Cooked it"
// button yet, this is just accumulating data for a planner later.
model CookLog {
  id       String   @id @default(cuid())
  recipeId String
  cookedAt DateTime @default(now())

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([recipeId])
}

// Joins a Recipe to a canonical Ingredient with quantity/unit/note.
// Quantity is never a freeform string so shopping-list math stays possible.
model RecipeIngredient {
  id           String  @id @default(cuid())
  recipeId     String
  ingredientId String
  quantity     Float?
  unit         Unit?
  // e.g. "finely chopped", "plus extra to serve"
  note         String?
  optional     Boolean @default(false)

  recipe     Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@index([recipeId])
  @@index([ingredientId])
}

// Ingredients currently in stock, with a rough stock level rather than a
// quantity. OUT is kept in the list (not deleted) so it's still there to
// bump back up to PLENTY once restocked.
model PantryItem {
  id           String     @id @default(cuid())
  ingredientId String     @unique
  stockLevel   StockLevel @default(PLENTY)
  // Set when this stock was recorded from a specific scanned product,
  // e.g. "the tomatoes I have are that jar", rather than a generic ingredient.
  productId    String?

  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  product    Product?   @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([productId])
}

// A packaged product identified by barcode, looked up against Open Food Facts
// or entered by hand. Composition only, no scoring, ratings, or judgement.
model Product {
  id                  String        @id @default(cuid())
  barcode             String        @unique
  name                String
  brand               String?
  rawIngredientsText  String?
  // Set when the ingredient text we stored isn't in English, so the UI can
  // explain why matching against the canonical catalog is likely to fail.
  ingredientsLanguage String?
  // Where the ingredients themselves come from, from Open Food Facts'
  // origins / origins_tags. Distinct from manufacturingPlace (where it was
  // made or packed) and soldIn (where it's stocked), which OFF tracks
  // separately and this app used to conflate into one misleading field.
  // Stored as tag slugs joined by commas when tags are available (e.g.
  // "united-states,mexico"), falling back to the free-text field otherwise,
  // so lib/countries.ts can resolve a flag either way.
  ingredientOrigin    String?
  // Where it was made or packed, from manufacturing_places / manufacturing_places_tags.
  manufacturingPlace  String?
  // Where it's sold, from countries_tags. This is what the old
  // countryOfOrigin field actually held, hence the rename, "sold in" is not
  // "from".
  soldIn              String?
  // User-entered correction, free text, shown and preserved in place of the
  // fields above when set (including across future rescans) since the API
  // data is sometimes wrong or missing.
  originOverride      String?
  // Raw nutriments blob as returned by the source, e.g. { "energy-kcal": 250, "fat": 12.3, ... }
  nutritionPer100g    Json?
  imageUrl            String?
  source              ProductSource
  firstScannedAt      DateTime      @default(now())
  lastScannedAt       DateTime      @default(now())

  ingredients ProductIngredient[]
  pantryItems PantryItem[]
  claims      ProductClaim[]
  snapshots   ProductSnapshot[]

  @@index([barcode])
}

// A front-of-pack claim (e.g. "Fairtrade", "Free Range") matched against the
// static lookup in lib/claims.ts at scan time, or added by hand when the
// text isn't in Open Food Facts' data at all.
model ProductClaim {
  id        String    @id @default(cuid())
  productId String
  claimText String
  claimType ClaimType
  // Null for an UNRECOGNISED claim the user hasn't annotated yet, since a
  // note is optional there. Always set for a matched claim (copied from
  // lib/claims.ts at the moment it's added).
  explanation String?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

// A point-in-time capture of a product's label data, written on every scan.
// A new snapshot is only kept when the ingredient text actually changed
// since the last one, so this accumulates real history rather than noise.
// No timeline UI yet, this is just so the data exists to build one later.
model ProductSnapshot {
  id                 String   @id @default(cuid())
  productId          String
  capturedAt         DateTime @default(now())
  rawIngredientsText String?
  nutritionPer100g   Json?
  sourceRevision     String?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

// One parsed line from a product's ingredients label.
model ProductIngredient {
  id            String  @id @default(cuid())
  productId     String
  // Position in the label, preserved because ingredient lists are ordered by weight.
  position      Int
  rawText       String
  ingredientId  String?
  eNumber       String?
  // Declared proportion only, e.g. "Potato (88%)" -> 88.0. Never OFF's own
  // percent_estimate/percent_min/percent_max guesses.
  percentage    Float?
  // The category header this line was parsed out from, e.g. "Sweeteners"
  // for an ingredient parsed out of "Sweeteners (Sorbitol, Aspartame)".
  // When a header has nothing in brackets after it, it's kept as its own
  // row with rawText equal to this same value, a function with no real
  // ingredient name, styled differently and not numbered.
  functionLabel String?

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredient Ingredient? @relation(fields: [ingredientId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([ingredientId])
}

// Notes on what a canonical ingredient (typically an additive) is and does.
// Starts empty; filled in by hand over time. No scoring, just explanation.
model IngredientInfo {
  id            String  @id @default(cuid())
  ingredientId  String  @unique
  // e.g. "thickener", "raising agent", "preservative"
  functionLabel String?
  // One or two sentences on what it is and what it's doing in this product.
  plainEnglish  String?
  eNumber       String?

  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
}

// The single ongoing shopping list. Recipe- and low-stock-derived rows are
// kept in sync with current recipe selection and pantry state (upserted by
// ingredient + origin); manual rows are freeform and never resolved to a
// canonical ingredient.
model ShoppingListItem {
  id                   String             @id @default(cuid())
  name                 String
  // Free text for all origins, e.g. "550 g" or "a bunch" - recipe-derived
  // items just have their summed amount formatted into this same field.
  quantityText         String?
  // A manual edit to the quantity. Takes priority over quantityText for
  // display, but doesn't overwrite it, so a recipe-derived amount stays
  // visible underneath until the override is cleared. A resync only ever
  // touches quantityText, never this.
  overrideQuantityText String?
  origin               ShoppingItemOrigin
  checked              Boolean            @default(false)
  ingredientId         String?
  createdAt            DateTime           @default(now())
  // Manual ordering within a category group (lower first), set via the
  // up/down reorder controls. New rows are appended past the current
  // highest value so they land at the end of the list, not the top.
  sortOrder            Int                @default(0)

  ingredient Ingredient? @relation(fields: [ingredientId], references: [id], onDelete: SetNull)

  @@unique([ingredientId, origin])
  @@index([ingredientId])
}

// One row per "clear the trolley" action (or a manually logged/scanned
// trip), for the monthly shopping tracker. The list itself is transient
// (ShoppingListItem rows are deleted once bought), so this is the only
// history that survives: a snapshot taken at clear time, not a live
// relation to items that no longer exist. totalSpent is a manually typed
// or receipt-read lump sum, independent of whatever the line items sum to
// (a receipt has tax/discounts an item list doesn't), null is fine, a trip
// is still worth keeping for its date and item count even unpriced.
model ShoppingTrip {
  id         String   @id @default(cuid())
  date       DateTime @default(now())
  totalSpent Float?
  itemCount  Int
  items      ShoppingTripItem[]

  @@index([date])
}

// A single line item within a trip, each with its own optional price so
// the tracker can build real per-ingredient price history over time, not
// just one lump sum per trip. ingredientId is best-effort (the same
// catalog matcher every other import path uses), left null when nothing
// matches rather than forcing a bad match, price prediction just skips
// unmatched rows.
model ShoppingTripItem {
  id           String  @id @default(cuid())
  tripId       String
  name         String
  quantityText String?
  price        Float?
  ingredientId String?

  trip       ShoppingTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  ingredient Ingredient?  @relation(fields: [ingredientId], references: [id], onDelete: SetNull)

  @@index([tripId])
  @@index([ingredientId])
}

// A week of dinner planning, one entry per day. UI comes later; modelled now.
model MealPlan {
  id        String   @id @default(cuid())
  startDate DateTime
  createdAt DateTime @default(now())
  // Per-week generation targets, editable, defaulting to 4 and 2. Not a
  // hard cap, generation aims for these counts across the week's slots.
  lowEffortTarget Int @default(4)
  batchTarget     Int @default(2)

  entries MealPlanEntry[]

  @@unique([startDate])
}

model MealPlanEntry {
  id         String   @id @default(cuid())
  mealPlanId String
  // Day this entry falls on, so entries can be reordered without reindexing.
  date       DateTime
  recipeId   String?
  // Leaves this slot alone on a week-wide "Generate", and skipped by
  // regeneration too, distinct from isLeftover which is a generation
  // outcome rather than a user lock.
  pinned     Boolean  @default(false)
  // True when this slot was generated as "eat yesterday's leftovers"
  // rather than a fresh dinner, placed automatically the day after a
  // batch-friendly recipe. recipeId is null on a leftover slot, the actual
  // dish is whatever leftoverOf points to.
  isLeftover Boolean  @default(false)
  leftoverOfEntryId String?
  // Set once "Cooked it" is pressed from the planner, so the button can't
  // double-log and the UI can show the slot as done. The CookLog row
  // itself is the source of truth for cook history everywhere else.
  cookedAt   DateTime?
  // Recipe ids vetoed from this slot in past regenerations this week, so
  // regenerating (or vetoing again) doesn't cycle back to something
  // already rejected. JSON string array.
  excludedRecipeIds Json?

  mealPlan   MealPlan        @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  recipe     Recipe?         @relation(fields: [recipeId], references: [id], onDelete: SetNull)
  leftoverOf MealPlanEntry?  @relation("LeftoverOf", fields: [leftoverOfEntryId], references: [id], onDelete: SetNull)
  leftoverEntries MealPlanEntry[] @relation("LeftoverOf")

  @@unique([mealPlanId, date])
  @@index([mealPlanId])
}
